
(function (Scratch) {
    "use strict";

    if (!Scratch.extensions.unsandboxed) {
        throw new Error("Useless Block cần chạy Unsandboxed!");
    }

    const SVG_NS = "http://www.w3.org/2000/svg";
    const SB = window.ScratchBlocks;

    const COLORS = [
        "#ff3838", "#ff8c00", "#ffe600",
        "#39ff14", "#00e5ff", "#1683ff",
        "#b84dff", "#ff42a1", "#ffffff"
    ];

    // Màu gốc cam vàng
    const COLOR1 = "#FFB52E";
    const COLOR2 = "#E99518";
    const COLOR3 = "#B86B08";

    // ==========================================
    // PARTICLE EXPLOSION
    // ==========================================

    function getStageRect() {
        const canvas = document.querySelector(".stage-wrapper canvas");

        if (canvas) return canvas.getBoundingClientRect();

        const canvases = [...document.querySelectorAll("canvas")];
        const stage = canvases.find(c =>
            c.width >= 400 && c.height >= 300
        );

        return stage ? stage.getBoundingClientRect() : null;
    }

    function explodeAt(x, y) {
        const rect = getStageRect();
        if (!rect || !rect.width || !rect.height) return;

        const cx = rect.left + (x + 240) / 480 * rect.width;
        const cy = rect.top + (180 - y) / 360 * rect.height;

        const overlay = document.createElementNS(SVG_NS, "svg");

        Object.assign(overlay.style, {
            position: "fixed",
            inset: "0",
            width: "100vw",
            height: "100vh",
            overflow: "hidden",
            pointerEvents: "none",
            zIndex: "999999"
        });

        overlay.setAttribute(
            "viewBox",
            `0 0 ${window.innerWidth} ${window.innerHeight}`
        );

        document.body.appendChild(overlay);

        const ring = document.createElementNS(SVG_NS, "circle");
        ring.setAttribute("cx", cx);
        ring.setAttribute("cy", cy);
        ring.setAttribute("r", 4);
        ring.setAttribute("fill", "none");
        ring.setAttribute("stroke", "#ffffff");
        ring.setAttribute("stroke-width", 5);
        overlay.appendChild(ring);

        const particles = [];

        for (let i = 0; i < 90; i++) {
            const isCircle = i % 3 === 0;
            const p = document.createElementNS(
                SVG_NS,
                isCircle ? "circle" : "rect"
            );

            const size = 3 + Math.random() * 8;
            const angle = Math.random() * Math.PI * 2;
            const speed = 2 + Math.random() * 12;

            if (isCircle) {
                p.setAttribute("r", size / 2);
            } else {
                p.setAttribute("x", -size / 2);
                p.setAttribute("y", -size / 2);
                p.setAttribute("width", size);
                p.setAttribute("height", size);
            }

            p.setAttribute(
                "fill",
                COLORS[Math.floor(Math.random() * COLORS.length)]
            );

            overlay.appendChild(p);

            particles.push({
                el: p,
                x: cx,
                y: cy,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                rotation: Math.random() * 360,
                spin: (Math.random() - 0.5) * 25
            });
        }

        const start = performance.now();
        const duration = 850;

        function animate(now) {
            if (!overlay.isConnected) return;

            const t = Math.min((now - start) / duration, 1);

            for (const p of particles) {
                p.x += p.vx;
                p.y += p.vy;
                p.vx *= 0.975;
                p.vy = p.vy * 0.975 + 0.12;
                p.rotation += p.spin;

                p.el.setAttribute(
                    "transform",
                    `translate(${p.x} ${p.y}) rotate(${p.rotation})`
                );
                p.el.setAttribute("opacity", 1 - t);
            }

            ring.setAttribute("r", 4 + t * 65);
            ring.setAttribute("opacity", 1 - t);
            ring.setAttribute("stroke-width", 5 * (1 - t));

            if (t < 1) requestAnimationFrame(animate);
            else overlay.remove();
        }

        requestAnimationFrame(animate);
    }

    function explodeAtBlock(block) {
        const svg = block?.getSvgRoot?.();
        if (!svg) return;

        const r = svg.getBoundingClientRect();
        const stage = getStageRect();

        if (!stage || !stage.width || !stage.height) return;

        const x =
            ((r.left + r.width / 2 - stage.left) / stage.width) * 480 - 240;

        const y =
            180 - ((r.top + r.height / 2 - stage.top) / stage.height) * 360;

        explodeAt(x, y);
    }

    // ==========================================
    // RAINBOW COLORS
    // Chỉ đổi màu các khối trong workspace
    // ==========================================

    let hue = 0;
    let colorTimerStarted = false;

    function startRainbow() {
        if (colorTimerStarted) return;
        colorTimerStarted = true;

        function update() {
            try {
                const workspace = SB?.getMainWorkspace?.();

                if (workspace) {
                    const color = `hsl(${hue}, 100%, 55%)`;
                    const darker = `hsl(${hue}, 100%, 42%)`;
                    const darkest = `hsl(${hue}, 100%, 32%)`;

                    for (const block of workspace.getAllBlocks(false)) {
                        if (
                            block.type !== "uselessblock_deleteSelf" &&
                            block.type !== "uselessblock_firework"
                        ) {
                            continue;
                        }

                        if (!block.workspace) continue;

                        try {
                            block.setColour(color, darker, darkest);
                        } catch (error) {
                            const root = block.getSvgRoot?.();

                            if (root) {
                                root.querySelectorAll(".blocklyPath")
                                    .forEach(path => {
                                        path.style.fill = color;
                                        path.style.stroke = darker;
                                    });
                            }
                        }
                    }
                }

                hue = (hue + 3) % 360;
            } catch (error) {
                console.error("[Useless Block] Rainbow:", error);
            }

            setTimeout(update, 50);
        }

        update();
    }

    class UselessBlock {
        constructor() {
            startRainbow();
        }

        getInfo() {
            return {
                id: "uselessblock",
                name: "Useless Block",

                color1: COLOR1,
                color2: COLOR2,
                color3: COLOR3,

                blocks: [
                    {
                        opcode: "deleteSelf",
                        blockType: Scratch.BlockType.COMMAND,
                        text: "useless block"
                    },
                    {
                        opcode: "firework",
                        blockType: Scratch.BlockType.COMMAND,
                        text: "firework block x: [X] y: [Y]",
                        arguments: {
                            X: {
                                type: Scratch.ArgumentType.NUMBER,
                                defaultValue: 0
                            },
                            Y: {
                                type: Scratch.ArgumentType.NUMBER,
                                defaultValue: 0
                            }
                        }
                    }
                ]
            };
        }

        deleteSelf(args, util) {
            const ws = SB?.getMainWorkspace?.();
            if (!ws) return;

            const id = util?.thread?.peekStack?.();
            const block = id ? ws.getBlockById(id) : null;

            if (!block || block.__deleting) return;

            block.__deleting = true;

            try {
                explodeAtBlock(block);
            } catch (error) {
                console.error("[Useless Block] Explosion:", error);
            }

            if (block.workspace) {
                block.dispose(true);
            }
        }

        firework(args) {
            const x = Math.max(-240, Math.min(240, Number(args.X) || 0));
            const y = Math.max(-180, Math.min(180, Number(args.Y) || 0));

            explodeAt(x, y);
        }
    }

    Scratch.extensions.register(new UselessBlock());
})(Scratch);
